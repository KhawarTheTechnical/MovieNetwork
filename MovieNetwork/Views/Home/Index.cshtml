@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid p-0">
    <!-- Top Carousel Section -->
    <div id="topCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/banner1.jpg" class="d-block w-100" alt="Banner 1" style="height: 500px; object-fit: cover;">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Welcome to MovieNetwork</h1>
                    <p>Discover your favorite movies and connect with other movie enthusiasts.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/banner2.jpg" class="d-block w-100" alt="Banner 2" style="height: 500px; object-fit: cover;">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Explore Featured Heroes</h1>
                    <p>Get to know the most iconic characters in movie history.</p>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/banner3.jpg" class="d-block w-100" alt="Banner 3" style="height: 500px; object-fit: cover;">
                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-4">Join the Community</h1>
                    <p>Sign up now and start your movie journey with us.</p>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#topCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#topCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>

    <!-- Main Content Section -->
    <div class="container mt-5">
        <div class="row">
            <!-- Sidebar: Featured Actors -->
            <div class="col-md-4">
                <h2 class="mb-4" style="font-weight: bold;">Featured Actors</h2>
                <ul class="list-group">
                    <li class="list-group-item bg-light text-dark mb-2 shadow-sm">
                        <h5>Actor 1</h5>
                        <p>Short description of Actor 1.</p>
                    </li>
                    <li class="list-group-item bg-light text-dark mb-2 shadow-sm">
                        <h5>Actor 2</h5>
                        <p>Short description of Actor 2.</p>
                    </li>
                    <li class="list-group-item bg-light text-dark mb-2 shadow-sm">
                        <h5>Actor 3</h5>
                        <p>Short description of Actor 3.</p>
                    </li>
                </ul>
            </div>

            <!-- Main Panel: Featured Movies -->
            <div class="col-md-8">
                <h2 class="text-center mb-4" style="font-weight: bold; color: #333;">Featured Movies</h2>
                <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="~/images/movie1.jpg" class="d-block w-100 rounded" alt="Movie 1">
                            <div class="carousel-caption d-none d-md-block">
                                <h5>The Power</h5>
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/movie2.jpg" class="d-block w-100 rounded" alt="Movie 2">
                            <div class="carousel-caption d-none d-md-block">
                                <h5>Movie Title 2</h5>
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="~/images/movie3.jpg" class="d-block w-100 rounded" alt="Movie 3">
                            <div class="carousel-caption d-none d-md-block">
                                <h5>Jaguar</h5>
                                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background-size: cover;
        background-position: center;
    }

    .list-group-item {
        border: none;
        border-radius: 10px;
    }

    .carousel-inner img {
        height: 400px;
        object-fit: cover;
    }

    .btn-light:hover {
        background-color: #f8f9fa;
        color: #2575fc;
    }
</style>

<script>
    // Initialize the carousels
    document.addEventListener("DOMContentLoaded", function () {
        const topCarousel = new bootstrap.Carousel(document.getElementById('topCarousel'), {
            interval: 3000,
            ride: 'carousel'
        });

        const featuredCarousel = new bootstrap.Carousel(document.getElementById('featuredCarousel'), {
            interval: 3000,
            ride: 'carousel'
        });
    });
</script>

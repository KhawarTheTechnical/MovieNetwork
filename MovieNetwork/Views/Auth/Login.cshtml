@{
    ViewData["Title"] = "Login";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 100%; max-width: 400px; border-radius: 15px;">
        <div class="card-body">
            <h2 class="text-center mb-4" style="font-weight: bold; color: #333;">Welcome Back</h2>
            <p class="text-center text-muted mb-4">Please log in to your account</p>

            <form id="loginForm" method="post" asp-action="Login" asp-controller="Auth">
                <div class="form-group mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" class="form-control" id="username" name="username" placeholder="Enter your username" required />
                </div>
                <div class="form-group mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100" style="border-radius: 25px;">Login</button>
            </form>

            <div class="text-center mt-4">
                <a asp-action="Signup" asp-controller="Auth" class="text-decoration-none" style="color: #007bff;">Don't have an account? Sign up here</a>
                <br />
                <a href="#" class="text-decoration-none text-muted">Forgot your password?</a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background: linear-gradient(to right, #6a11cb, #2575fc);
        color: #fff;
        font-family: 'Arial', sans-serif;
    }

    .card {
        background-color: #fff;
        color: #333;
    }

    .form-control {
        border-radius: 25px;
        padding: 10px 15px;
    }

    .btn-primary {
        background-color: #6a11cb;
        border: none;
    }

    .btn-primary:hover {
        background-color: #2575fc;
    }
</style>